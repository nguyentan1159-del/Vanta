local function addButton(parent, title, callback)
    local holder = row(parent, 50)
    label(holder, title, "Press to run this interface action")
    local button = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(94, 30),
        BackgroundColor3 = Theme.Surface3,
        AutoButtonColor = false,
        Font = Enum.Font.GothamSemibold,
        Text = "Execute",
        TextColor3 = Theme.Text,
        TextSize = 10,
        ZIndex = 5
    }, holder)
    corner(button, 8)
    stroke(button, Theme.Border, 0.2, 1)
    button.MouseEnter:Connect(function()
        tween(button, 0.15, {BackgroundColor3 = Theme.Accent})
    end)
    button.MouseLeave:Connect(function()
        tween(button, 0.15, {BackgroundColor3 = Theme.Surface3})
    end)
    button.Activated:Connect(function()
        if callback then callback() end
    end)
    return holder
end

local function addToggle(parent, title, description, defaultValue, callback)
    local holder = row(parent, 54)
    label(holder, title, description)
    local enabled = defaultValue == true

    local track = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(42, 23),
        BackgroundColor3 = enabled and Theme.Accent or Theme.Surface3,
        AutoButtonColor = false,
        Text = "",
        ZIndex = 5
    }, holder)
    corner(track, 20)

    local knob = create("Frame", {
        Position = enabled and UDim2.fromOffset(22, 3) or UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(17, 17),
        BackgroundColor3 = Color3.fromRGB(245, 247, 252),
        BorderSizePixel = 0,
        ZIndex = 6
    }, track)
    corner(knob, 20)

    local function set(value)
        enabled = value
        tween(track, 0.16, {BackgroundColor3 = enabled and Theme.Accent or Theme.Surface3})
        tween(knob, 0.16, {Position = enabled and UDim2.fromOffset(22, 3) or UDim2.fromOffset(3, 3)})
        if callback then callback(enabled) end
    end

    track.Activated:Connect(function()
        set(not enabled)
    end)
    return {
        Set = set,
        Get = function() return enabled end
    }
end

local function addSlider(parent, title, minimum, maximum, initial, callback)
    local holder = row(parent, 68)
    create("TextLabel", {
        Position = UDim2.fromOffset(13, 8),
        Size = UDim2.new(1, -80, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4
    }, holder)

    local valueLabel = create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -13, 0, 8),
        Size = UDim2.fromOffset(52, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamSemibold,
        Text = tostring(initial),
        TextColor3 = Theme.Accent,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 4
    }, holder)

    local rail = create("Frame", {
        Position = UDim2.fromOffset(13, 42),
        Size = UDim2.new(1, -26, 0, 5),
        BackgroundColor3 = Theme.Surface3,
        BorderSizePixel = 0,
        ZIndex = 4
    }, holder)
    corner(rail, 5)

    local alpha = math.clamp((initial - minimum) / (maximum - minimum), 0, 1)
    local fill = create("Frame", {
        Size = UDim2.new(alpha, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 5
    }, rail)
    corner(fill, 5)

    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(alpha, 0, 0.5, 0),
        Size = UDim2.fromOffset(13, 13),
        BackgroundColor3 = Color3.fromRGB(245, 247, 252),
        BorderSizePixel = 0,
        ZIndex = 6
    }, rail)
    corner(knob, 10)

    local dragging = false
    local current = initial
    local function setFromX(x)
        local percent = math.clamp((x - rail.AbsolutePosition.X) / rail.AbsoluteSize.X, 0, 1)
        current = math.floor(minimum + (maximum - minimum) * percent + 0.5)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        knob.Position = UDim2.new(percent, 0, 0.5, 0)
        valueLabel.Text = tostring(current)
        if callback then callback(current) end
    end

    rail.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        Set = function(value)
            current = math.clamp(math.floor(value + 0.5), minimum, maximum)
            local percent = (current - minimum) / (maximum - minimum)
            fill.Size = UDim2.new(percent, 0, 1, 0)
            knob.Position = UDim2.new(percent, 0, 0.5, 0)
            valueLabel.Text = tostring(current)
        end,
        Get = function() return current end
    }
end

