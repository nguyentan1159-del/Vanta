        UDim2.fromOffset(180, 25),
        UDim2.fromOffset(59, 9),
        Enum.Font.GothamBold,
        Theme.Text
    ).TextSize = 17

    MakeLabel(
        self.Header,
        "PREMIUM INTERFACE",
        UDim2.fromOffset(180, 15),
        UDim2.fromOffset(60, 32),
        Enum.Font.Gotham,
        Theme.Muted
    ).TextSize = 9

    local close = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -15, 0.5, 0),
        Size = UDim2.fromOffset(29, 29),
        BackgroundColor3 = Color3.fromRGB(55, 31, 39),
