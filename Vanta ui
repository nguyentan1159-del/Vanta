local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
if not Player then return end

local PlayerGui = Player:WaitForChild("PlayerGui")

local VANTA = {}
VANTA.__index = VANTA

local Theme = {
    Background = Color3.fromRGB(10, 12, 18),
    Surface = Color3.fromRGB(17, 21, 30),
    Surface2 = Color3.fromRGB(24, 29, 41),
    Surface3 = Color3.fromRGB(32, 39, 54),
    Border = Color3.fromRGB(48, 58, 77),
    Text = Color3.fromRGB(240, 244, 252),
    Muted = Color3.fromRGB(139, 151, 173),
    Accent = Color3.fromRGB(83, 145, 255),
    Purple = Color3.fromRGB(137, 102, 255),
    Green = Color3.fromRGB(75, 205, 151),
    Red = Color3.fromRGB(240, 91, 105)
}

local function New(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function Corner(obj, radius)
    New("UICorner", {
        CornerRadius = UDim.new(0, radius or 9)
    }, obj)
end

local function Stroke(obj, color, transparency)
    return New("UIStroke", {
        Color = color or Theme.Border,
        Transparency = transparency or 0,
        Thickness = 1
    }, obj)
end

local function Tween(obj, props, duration)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function Gradient(obj)
    New("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.Accent),
            ColorSequenceKeypoint.new(1, Theme.Purple)
        }),
        Rotation = 0
    }, obj)
end

local function MakeLabel(parent, text, size, position, font, color)
    return New("TextLabel", {
        BackgroundTransparency = 1,
        Position = position,
        Size = size,
        Font = font or Enum.Font.GothamMedium,
        Text = text,
        TextColor3 = color or Theme.Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)
end

