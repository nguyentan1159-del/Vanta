-- Language: Luau
-- File: VANTA_UI.lua
-- Runtime: Roblox Studio / LocalScript

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

local VANTA = {}

VANTA.Theme = {
    Background = Color3.fromRGB(9, 11, 19),
    Surface = Color3.fromRGB(17, 21, 33),
    Secondary = Color3.fromRGB(25, 30, 45),
    Accent = Color3.fromRGB(83, 115, 255),
    Purple = Color3.fromRGB(151, 91, 255),
    Text = Color3.fromRGB(240, 243, 255),
    Muted = Color3.fromRGB(130, 140, 165),
    Border = Color3.fromRGB(42, 49, 69)
}

local Theme = VANTA.Theme

local function Create(class, properties, parent)
    local object = Instance.new(class)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function Corner(parent, radius)
    return Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10)
    }, parent)
end

local function Stroke(parent, color, transparency)
    return Create("UIStroke", {
        Color = color or Theme.Border,
        Thickness = 1,
        Transparency = transparency or 0
    }, parent)
end

local function Tween(object, properties, duration)
    local animation = TweenService:Create(
        object,
        TweenInfo.new(
            duration or 0.2,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        properties
    )

    animation:Play()
    return animation
end

function VANTA:CreateWindow(config)
    config = config or {}

    local ScreenGui = Create("ScreenGui", {
        Name = "VANTA_UI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, Player:WaitForChild("PlayerGui"))

    local Main = Create("Frame", {
        Name = "Window",
        Size = UDim2.fromOffset(570, 390),
        Position = UDim2.new(0.5, -285, 0.5, -195),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, ScreenGui)

    Corner(Main, 14)
    Stroke(Main, Theme.Border)

    local Scale = Create("UIScale", {
        Scale = 1
    }, Main)

    local function UpdateScale()
        local camera = workspace.CurrentCamera
        if not camera then return end

        local viewport = camera.ViewportSize
        Scale.Scale = math.min(
            1,
            viewport.X / 620,
            viewport.Y / 440
        )
    end

    UpdateScale()

    local Topbar = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0
    }, Main)

    local Title = Create("TextLabel", {
        Position = UDim2.fromOffset(17, 0),
        Size = UDim2.new(0.6, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = config.Name or "VANTA UI",
        TextColor3 = Theme.Text,
        TextSize = 16,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Topbar)

    local Close = Create("TextButton", {
        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.new(1, -40, 0, 9),
        BackgroundColor3 = Theme.Secondary,
        Text = "×",
        TextColor3 = Theme.Text,
        TextSize = 20,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false
    }, Topbar)

    Corner(Close, 8)

    Close.MouseButton1Click:Connect(function()
        Tween(Main, {
            Size = UDim2.fromOffset(0, 0)
        }, 0.18)

        task.delay(0.2, function()
            ScreenGui:Destroy()
        end)
    end)

    -- Draggable window
    local dragging = false
    local dragStart, startPosition

    Topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = Main.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Sidebar
    local Sidebar = Create("Frame", {
        Position = UDim2.fromOffset(10, 58),
        Size = UDim2.new(0, 125, 1, -68),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0
    }, Main)

    Corner(Sidebar, 10)

    local TabLayout = Create("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, Sidebar)

    Create("UIPadding", {
        PaddingTop = UDim.new(0, 9),
        PaddingLeft = UDim.new(0, 7),
        PaddingRight = UDim.new(0, 7)
    }, Sidebar)

    -- Content
    local Content = Create("Frame", {
        Position = UDim2.fromOffset(145, 58),
        Size = UDim2.new(1, -155, 1, -68),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, Main)

    Corner(Content, 10)

    local Pages = {}
    local CurrentTab = nil

    local function SelectTab(name)
        for tabName, page in pairs(Pages) do
            page.Visible = tabName == name
        end

        CurrentTab = name
    end

    function VANTA:CreateTab(name)
        local Page = Create("ScrollingFrame", {
            Name = name,
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Visible = false
        }, Content)

        Create("UIListLayout", {
            Padding = UDim.new(0, 9),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, Page)

        Create("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12)
        }, Page)

        local function UpdateCanvas()
            Page.CanvasSize = UDim2.fromOffset(
                0,
                Page.UIListLayout.AbsoluteContentSize.Y + 24
            )
        end

        Page.UIListLayout:GetPropertyChangedSignal(
            "AbsoluteContentSize"
        ):Connect(UpdateCanvas)

        Pages[name] = Page

        local TabButton = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Theme.Secondary,
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = Theme.Muted,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            AutoButtonColor = false
        }, Sidebar)

        Corner(TabButton, 7)

        TabButton.MouseButton1Click:Connect(function()
            SelectTab(name)

            for tabName, button in pairs(Sidebar:GetChildren()) do
                if button:IsA("TextButton") then
                    Tween(button, {
                        BackgroundTransparency = button == TabButton and 0 or 1,
                        TextColor3 = button == TabButton
                            and Theme.Text or Theme.Muted
                    }, 0.15)
                end
            end
        end)

        local Tab = {}

        function Tab:Section(sectionName)
            Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 25),
                BackgroundTransparency = 1,
                Text = sectionName,
                TextColor3 = Theme.Accent,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Page)
        end

        function Tab:Button(text, callback)
            local Button = Create("TextButton", {
                Size = UDim2.new(1, 0, 0, 37),
                BackgroundColor3 = Theme.Secondary,
                Text = text,
                TextColor3 = Theme.Text,
                TextSize = 12,
                Font = Enum.Font.GothamMedium,
                AutoButtonColor = false
            }, Page)

            Corner(Button, 8)

            Button.MouseButton1Click:Connect(function()
                Tween(Button, {
                    BackgroundColor3 = Theme.Accent
                }, 0.1)

                task.delay(0.12, function()
                    if Button.Parent then
                        Tween(Button, {
                            BackgroundColor3 = Theme.Secondary
                        }, 0.15)
                    end
                end)

                if callback then
                    callback()
                end
            end)

            return Button
        end

        function Tab:Toggle(text, default, callback)
            local enabled = default or false

            local Row = Create("TextButton", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = Theme.Secondary,
                Text = "",
                AutoButtonColor = false
            }, Page)

            Corner(Row, 8)

            Create("TextLabel", {
                Position = UDim2.fromOffset(11, 0),
                Size = UDim2.new(0.7, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Theme.Text,
                TextSize = 12,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Row)

            local Indicator = Create("Frame", {
                Position = UDim2.new(1, -43, 0.5, -8),
                Size = UDim2.fromOffset(31, 16),
                BackgroundColor3 = enabled and Theme.Accent or Theme.Border
            }, Row)

            Corner(Indicator, 20)

            local Dot = Create("Frame", {
                Position = enabled
                    and UDim2.new(1, -14, 0.5, -5)
                    or UDim2.new(0, 4, 0.5, -5),
                Size = UDim2.fromOffset(10, 10),
                BackgroundColor3 = Color3.new(1, 1, 1)
            }, Indicator)

            Corner(Dot, 20)

            Row.MouseButton1Click:Connect(function()
                enabled = not enabled

                Tween(Indicator, {
                    BackgroundColor3 = enabled and Theme.Accent or Theme.Border
                }, 0.15)

                Tween(Dot, {
                    Position = enabled
                        and UDim2.new(1, -14, 0.5, -5)
                        or UDim2.new(0, 4, 0.5, -5)
                }, 0.15)

                if callback then
                    callback(enabled)
                end
            end)

            return {
                Set = function(_, value)
                    enabled = value
                    Tween(Indicator, {
                        BackgroundColor3 = enabled and Theme.Accent or Theme.Border
                    }, 0.15)

                    Tween(Dot, {
                        Position = enabled
                            and UDim2.new(1, -14, 0.5, -5)
                            or UDim2.new(0, 4, 0.5, -5)
                    }, 0.15)

                    if callback then callback(enabled) end
                end
            }
        end

        function Tab:Label(text)
            return Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 25),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Theme.Muted,
                TextSize = 11,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Page)
        end

        function Tab:Slider(text, min, max, default, callback)
            local value = math.clamp(default or min, min, max)

            local Row = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 57),
                BackgroundColor3 = Theme.Secondary
            }, Page)

            Corner(Row, 8)

            local Label = Create("TextLabel", {
                Position = UDim2.fromOffset(10, 5),
                Size = UDim2.new(0.7, 0, 0, 20),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Theme.Text,
                TextSize = 11,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Row)

            local ValueLabel = Create("TextLabel", {
                Position = UDim2.new(0.7, 0, 0, 5),
                Size = UDim2.new(0.25, 0, 0, 20),
                BackgroundTransparency = 1,
                Text = tostring(value),
                TextColor3 = Theme.Accent,
                TextSize = 11,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Right
            }, Row)

            local Bar = Create("Frame", {
                Position = UDim2.fromOffset(10, 37),
                Size = UDim2.new(1, -20, 0, 5),
                BackgroundColor3 = Theme.Border
            }, Row)

            Corner(Bar, 10)

            local Fill = Create("Frame", {
                Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = Theme.Accent
            }, Bar)

            Corner(Fill, 10)

            local Hitbox = Create("TextButton", {
                Size = UDim2.new(1, 0, 0, 20),
                Position = UDim2.new(0, 0, 0.5, -10),
                BackgroundTransparency = 1,
                Text = "",
                AutoButtonColor = false
            }, Bar)

            local function SetValue(position)
                local percent = math.clamp(
                    (position - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,
                    0, 1
                )

                value = math.floor(min + (max - min) * percent)

                Tween(Fill, {
                    Size = UDim2.new(percent, 0, 1, 0)
                }, 0.08)

                ValueLabel.Text = tostring(value)

                if callback then callback(value) end
            end

            Hitbox.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    SetValue(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                    if UserInputService:IsMouseButtonPressed(
                        Enum.UserInputType.MouseButton1
                    ) then
                        SetValue(input.Position.X)
                    end
                end
            end)

            return {
                Set = function(_, newValue)
                    value = math.clamp(newValue, min, max)
                    local percent = (value - min) / (max - min)

                    Fill.Size = UDim2.new(percent, 0, 1, 0)
                    ValueLabel.Text = tostring(value)

                    if callback then callback(value) end
                end
            }
        end

        if not CurrentTab then
            SelectTab(name)
            TabButton.BackgroundTransparency = 0
            TabButton.TextColor3 = Theme.Text
        end

        return Tab
    end

    function self_destroy()
        ScreenGui:Destroy()
    end

    return {
        Gui = ScreenGui,
        Main = Main,
        Destroy = function()
            ScreenGui:Destroy()
        end
    }
end

return VANTA
